# Inteligência Artificial (Gerenciada pelo Painel Admin em /admin/chaves-api)
# Agora você pode cadastrar e alternar entre múltiplos provedores com failover automático:
# Google Gemini, OpenAI, DeepSeek, Groq, OpenRouter, Anthropic Claude ou Personalizado (Ollama/vLLM)
# A configuração via .env abaixo é opcional (usada apenas como contingência de emergência):
# GEMINI_API_KEY=

# Banco de Dados (MariaDB / MySQL)
DATABASE_URL=mysql://usuario:senha@localhost:3306/conectaenem

# E-mail (SMTP via Nodemailer — compatível com Brevo, Outlook, etc.)
# Brevo: smtp-relay.brevo.com | porta 587 | login = seu e-mail Brevo | senha = chave SMTP do Brevo
# Outlook: smtp-mail.outlook.com | porta 587 | login = seu e-mail | senha = sua senha
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=seuemail@brevo.com
SMTP_PASS=sua_chave_smtp_aqui
EMAIL_FROM=seuemail@dominio.com
EMAIL_FROM_NAME=Conecta Enem
