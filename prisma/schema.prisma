generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum OptionLetter {
  A
  B
  C
  D
  E
}

model User {
  id            String  @id @default(uuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false) @map("email_verified")
  image         String?
  role          Role    @default(STUDENT)
  active        Boolean @default(true)

  accounts       Account[]
  sessions       Session[]
  teacherProfile TeacherProfile?
  classroomsLed  Classroom[]     @relation("TeacherClassrooms")
  enrollments    ClassroomMember[]
  essaysSubmitted Essay[]        @relation("StudentEssays")
  essaysGraded   EssayCorrection[] @relation("TeacherCorrections")
  lessonProgress LessonProgress[]
  questionAnswers QuestionAnswer[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([role])
  @@index([active])
  @@map("users")
}

model Account {
  id           String  @id @default(uuid())
  userId       String  @map("user_id")
  accountId    String  @map("account_id")
  providerId   String  @map("provider_id")
  password     String?
  accessToken  String? @map("access_token")
  refreshToken String? @map("refresh_token")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("sessions")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

model TeacherProfile {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("teacher_profiles")
}

model Classroom {
  id          String    @id @default(uuid())
  teacherId   String    @map("teacher_id")
  name        String
  description String?   @db.Text
  code        String    @unique
  inviteToken String    @unique @default(uuid()) @map("invite_token")
  maxStudents Int?      @map("max_students")
  expiresAt   DateTime? @map("expires_at")
  active      Boolean   @default(true)

  teacher User              @relation("TeacherClassrooms", fields: [teacherId], references: [id], onDelete: Cascade)
  members ClassroomMember[]
  essays  Essay[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([teacherId])
  @@index([code])
  @@index([inviteToken])
  @@index([active])
  @@map("classrooms")
}

model ClassroomMember {
  id          String   @id @default(uuid())
  classroomId String   @map("classroom_id")
  studentId   String   @map("student_id")
  joinedAt    DateTime @default(now()) @map("joined_at")

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classroomId, studentId])
  @@index([classroomId])
  @@index([studentId])
  @@map("classroom_members")
}

enum EssayStatus {
  PENDING
  CORRECTING
  GRADED
}

enum AnnotationType {
  DRAW
  HIGHLIGHT
  UNDERLINE
  STRIKE
  CIRCLE
  ARROW
  COMMENT
}

enum AnnotationCategory {
  GRAMMAR
  ARGUMENTATION
  COHESION
  REPERTOIRE
  STRUCTURE
  PROPOSAL
  VOCABULARY
  OTHER
}

model Essay {
  id             String      @id @default(uuid())
  studentId      String      @map("student_id")
  classroomId    String?     @map("classroom_id")
  title          String?
  theme          String
  content        String?     @db.Text
  imageUrl       String?     @map("image_url") @db.LongText
  submissionType String      @default("TEXT") @map("submission_type")
  status         EssayStatus @default(PENDING)

  student     User             @relation("StudentEssays", fields: [studentId], references: [id], onDelete: Cascade)
  classroom   Classroom?       @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  correction  EssayCorrection?
  annotations EssayAnnotation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([studentId])
  @@index([classroomId])
  @@index([status])
  @@map("essays")
}

model EssayCorrection {
  id        String @id @default(uuid())
  essayId   String @unique @map("essay_id")
  teacherId String @map("teacher_id")

  c1Score Int @default(0) @map("c1_score")
  c2Score Int @default(0) @map("c2_score")
  c3Score Int @default(0) @map("c3_score")
  c4Score Int @default(0) @map("c4_score")
  c5Score Int @default(0) @map("c5_score")
  totalScore Int @default(0) @map("total_score")

  c1Comment String? @db.Text @map("c1_comment")
  c2Comment String? @db.Text @map("c2_comment")
  c3Comment String? @db.Text @map("c3_comment")
  c4Comment String? @db.Text @map("c4_comment")
  c5Comment String? @db.Text @map("c5_comment")

  justification1 String? @db.Text @map("justification_1")
  justification2 String? @db.Text @map("justification_2")
  justification3 String? @db.Text @map("justification_3")
  justification4 String? @db.Text @map("justification_4")
  justification5 String? @db.Text @map("justification_5")

  positivePoints  String? @db.Text @map("positive_points")
  improvements    String? @db.Text @map("improvements")
  generalComment  String? @db.Text @map("general_comment")
  generalFeedback String? @db.Text @map("general_feedback")

  essay   Essay @relation(fields: [essayId], references: [id], onDelete: Cascade)
  teacher User  @relation("TeacherCorrections", fields: [teacherId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([teacherId])
  @@map("essay_corrections")
}

model EssayAnnotation {
  id          String              @id @default(uuid())
  essayId     String              @map("essay_id")
  type        AnnotationType      @default(DRAW)
  category    AnnotationCategory?
  color       String              @default("#ef4444")
  strokeWidth Float               @default(3.0) @map("stroke_width")

  content     String?             @db.Text
  selectedText String?            @db.Text @map("selected_text")

  startOffset Int?                @map("start_offset")
  endOffset   Int?                @map("end_offset")

  x           Float?
  y           Float?
  width       Float?
  height      Float?

  points      String?             @db.LongText

  essay       Essay               @relation(fields: [essayId], references: [id], onDelete: Cascade)

  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@index([essayId])
  @@index([type])
  @@map("essay_annotations")
}

model Subject {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  order       Int     @default(0)
  active      Boolean @default(true)

  modules   Module[]
  questions Question[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@index([order])
  @@map("subjects")
}

model Module {
  id          String  @id @default(uuid())
  subjectId   String  @map("subject_id")
  name        String
  slug        String
  description String?
  order       Int     @default(0)
  active      Boolean @default(true)

  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([subjectId, slug])
  @@index([subjectId])
  @@index([active])
  @@index([order])
  @@map("modules")
}

model Lesson {
  id          String  @id @default(uuid())
  moduleId    String  @map("module_id")
  title       String
  description String?
  videoUrl    String? @map("video_url")
  order       Int     @default(0)
  active      Boolean @default(true)

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([moduleId])
  @@index([active])
  @@index([order])
  @@map("lessons")
}

model Question {
  id            String       @id @default(uuid())
  subjectId     String       @map("subject_id")
  title         String?
  statement     String       @db.Text
  explanation   String?      @db.Text
  imageUrl      String?      @map("image_url") @db.LongText
  images        String?      @db.LongText
  difficulty    Difficulty
  year          Int?
  correctAnswer OptionLetter
  active        Boolean      @default(true)

  subject Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  options QuestionOption[]
  answers QuestionAnswer[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([subjectId])
  @@index([difficulty])
  @@index([year])
  @@index([active])
  @@map("questions")
}

model QuestionOption {
  id         String       @id @default(uuid())
  questionId String       @map("question_id")
  letter     OptionLetter
  text       String?      @db.Text
  imageUrl   String?      @map("image_url") @db.LongText

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([questionId, letter])
  @@index([questionId])
  @@map("question_options")
}

model EssayTopic {
  id             String   @id @default(uuid())
  title          String
  axis           String?
  description    String?  @db.Text
  motivationText String?  @map("motivation_text") @db.LongText
  imageUrl       String?  @map("image_url") @db.LongText
  active         Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@index([axis])
  @@map("essay_topics")
}

model EssayArgument {
  id          String   @id @default(uuid())
  title       String
  axis        String?
  content     String   @db.Text
  application String?  @db.Text
  active      Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@index([axis])
  @@map("essay_arguments")
}

model EssayRepertoire {
  id        String   @id @default(uuid())
  title     String
  author    String?
  axis      String?
  content   String   @db.Text
  quote     String?  @db.Text
  active    Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@index([axis])
  @@map("essay_repertoires")
}

model LessonProgress {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  lessonId  String   @map("lesson_id")
  completed Boolean  @default(true)
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model QuestionAnswer {
  id         String       @id @default(uuid())
  userId     String       @map("user_id")
  questionId String       @map("question_id")
  option     OptionLetter
  isCorrect  Boolean      @map("is_correct")
  
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([questionId])
  @@index([isCorrect])
  @@map("question_answers")
}


model ApiKey {
  id         String    @id @default(uuid())
  provider   String    @default("GEMINI")
  name       String
  key        String    @db.Text
  active     Boolean   @default(true)
  lastUsedAt DateTime? @map("last_used_at")
  errorCount Int       @default(0) @map("error_count")
  lastError  String?   @db.Text @map("last_error")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([provider])
  @@index([active])
  @@map("api_keys")
}
